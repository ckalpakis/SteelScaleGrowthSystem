# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key, used by API routes to insert leads and read client config.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Agency super-admins (comma-separated emails). These logins get the "Clients"
# admin area to create and manage every client from the dashboard.
AGENCY_ADMIN_EMAILS=you@steelscale.xyz

# Client onboarding invitation link lifetime, in days (default 14).
ONBOARDING_INVITATION_TTL_DAYS=14

# Public base URL of the deployment (used for SEO canonical/JSON-LD links).
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Agency root domain. REQUIRED to enable client custom domains / subdomains.
# When set, any host that is not this domain (or www./app. of it, or a
# *.vercel.app preview) is treated as a client site:
#   - <slug>.steelscale.xyz        -> tenant by subdomain label
#   - a client's own domain        -> tenant by clients.domain lookup
# Leave unset to keep every request on the agency app (feature off).
ROOT_DOMAIN=steelscale.xyz

# Resend (email notifications for new leads)
RESEND_API_KEY=your-resend-api-key
# The verified "from" address Resend will send notifications from.
LEAD_NOTIFICATION_FROM="Steel City Growth <leads@yourdomain.com>"
# Steel Scale's own inbox, BCC'd on every client's new-lead email (optional).
AGENCY_NOTIFICATION_EMAIL="leads@steelscale.xyz"

# Twilio (legacy single-account SMS). One agency account texts on behalf of
# every client. Still used by the older review-request flow. Optional.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Review-request webhook (POST /api/review, GoHighLevel → Twilio). Uses Twilio
# API-key auth + a Messaging Service SID (not a from number).
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-twilio-api-secret
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared secret every /api/review caller must send in the x-steelscale-secret
# header. Generate a long random string, e.g. openssl rand -hex 32
STEELSCALE_WEBHOOK_SECRET=a-long-random-webhook-secret

# Reputation module — per-company Twilio. Each company stores its own Account
# SID, Auth Token, Messaging Service SID, and phone number in the database via
# Settings; the auth token is encrypted at rest with this key. Generate 32
# random bytes, e.g.  openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key

# Public base URL of the app, used to build Twilio status/inbound webhook URLs
# and review-link short URLs. e.g. https://app.steelscale.xyz
NEXT_PUBLIC_APP_URL=https://app.steelscale.xyz

# Base URL for review-link short URLs (growth.steelscale.com/r/abc123).
# Falls back to NEXT_PUBLIC_APP_URL when unset.
NEXT_PUBLIC_REVIEW_LINK_BASE=https://growth.steelscale.com

# Secret that protects the daily review-request cron (/api/cron/review-requests).
# Set the same value in Vercel; Vercel Cron sends it as a Bearer token.
CRON_SECRET=a-long-random-string

# Jobber integration (OAuth). Used by the Jobber adapter once live API calls
# are wired. Create an app at developer.getjobber.com.
JOBBER_CLIENT_ID=your-jobber-client-id
JOBBER_CLIENT_SECRET=your-jobber-client-secret
JOBBER_REDIRECT_URI=https://app.steelscale.xyz/api/integrations/jobber/callback

# Housecall Pro integration (OAuth). Used by the Housecall Pro adapter once
# live API calls are wired.
HOUSECALL_CLIENT_ID=your-housecall-client-id
HOUSECALL_CLIENT_SECRET=your-housecall-client-secret
HOUSECALL_REDIRECT_URI=https://app.steelscale.xyz/api/integrations/housecall/callback

# ServiceTitan integration. Client-credentials auth + an app key + tenant id
# (no redirect). Used by the ServiceTitan adapter once live API calls are wired.
SERVICETITAN_CLIENT_ID=your-servicetitan-client-id
SERVICETITAN_CLIENT_SECRET=your-servicetitan-client-secret
SERVICETITAN_APP_KEY=your-servicetitan-app-key
SERVICETITAN_TENANT_ID=your-servicetitan-tenant-id

# Google Business Profile (live reviews sync). OAuth client from Google Cloud
# with the Business Profile APIs enabled. Redirect URI must match exactly.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://app.steelscale.xyz/api/integrations/google/callback

# =============================================================================
# GoHighLevel (HighLevel) agency integration — server-only.
# Used to create sub-accounts (locations), mint location tokens, read/update
# location custom values, and list snapshots. See docs/ghl-authentication-setup.md.
# NEVER expose these to the browser.
# =============================================================================
# oauth (recommended) | private_integration
GHL_AUTH_METHOD=oauth
# Your agency / Company id (required for all methods)
GHL_COMPANY_ID=your-ghl-company-id
# Optional API surface overrides
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_TIMEOUT_MS=15000
# Space/comma-separated scopes the token actually holds (fast scope verification)
GHL_GRANTED_SCOPES=locations.readonly locations.write locations/customValues.readonly locations/customValues.write snapshots.readonly

# --- OAuth (GHL_AUTH_METHOD=oauth) ---
GHL_CLIENT_ID=your-ghl-marketplace-client-id
GHL_CLIENT_SECRET=your-ghl-marketplace-client-secret
GHL_ACCESS_TOKEN=seed-agency-access-token-from-oauth-install
GHL_REFRESH_TOKEN=seed-agency-refresh-token-from-oauth-install
# Optional: ISO timestamp of access-token expiry, and token endpoint override
GHL_TOKEN_EXPIRES_AT=
GHL_TOKEN_URL=

# --- Private Integration Token (GHL_AUTH_METHOD=private_integration) ---
GHL_PRIVATE_INTEGRATION_TOKEN=your-ghl-private-integration-token

# --- Onboarding provisioning worker (optional tuning) ---
# The review snapshot loaded into a new sub-account (used in admin instructions
# and, if/when an official apply API exists, automated application).
GHL_REVIEW_SNAPSHOT_ID=
GHL_REVIEW_SNAPSHOT_NAME=Steel Scale Review System
# Lease + retry tuning (safe defaults if unset)
PROVISIONING_LEASE_SECONDS=300
PROVISIONING_MAX_ATTEMPTS=4
# Base URL used to build a "Open GHL sub-account" admin link (no secrets)
NEXT_PUBLIC_GHL_APP_URL=https://app.gohighlevel.com
