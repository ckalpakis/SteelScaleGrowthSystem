# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key, used by API routes to insert leads and read client config.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Agency super-admins (comma-separated emails). These logins get the "Clients"
# admin area to create and manage every client from the dashboard.
AGENCY_ADMIN_EMAILS=you@steelscale.xyz

# Public base URL of the deployment (used for SEO canonical/JSON-LD links).
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Agency root domain. REQUIRED to enable client custom domains / subdomains.
# When set, any host that is not this domain (or www./app. of it, or a
# *.vercel.app preview) is treated as a client site:
#   - <slug>.steelscale.xyz        -> tenant by subdomain label
#   - a client's own domain        -> tenant by clients.domain lookup
# Leave unset to keep every request on the agency app (feature off).
ROOT_DOMAIN=steelscale.xyz

# Resend (email notifications for new leads)
RESEND_API_KEY=your-resend-api-key
# The verified "from" address Resend will send notifications from.
LEAD_NOTIFICATION_FROM="Steel City Growth <leads@yourdomain.com>"
# Steel Scale's own inbox, BCC'd on every client's new-lead email (optional).
AGENCY_NOTIFICATION_EMAIL="leads@steelscale.xyz"

# Twilio (legacy single-account SMS). One agency account texts on behalf of
# every client. Still used by the older review-request flow. Optional.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Reputation module — per-company Twilio. Each company stores its own Account
# SID, Auth Token, Messaging Service SID, and phone number in the database via
# Settings; the auth token is encrypted at rest with this key. Generate 32
# random bytes, e.g.  openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key

# Public base URL of the app, used to build Twilio status/inbound webhook URLs
# and review-link short URLs. e.g. https://app.steelscale.xyz
NEXT_PUBLIC_APP_URL=https://app.steelscale.xyz

# Base URL for review-link short URLs (growth.steelscale.com/r/abc123).
# Falls back to NEXT_PUBLIC_APP_URL when unset.
NEXT_PUBLIC_REVIEW_LINK_BASE=https://growth.steelscale.com

# Secret that protects the daily review-request cron (/api/cron/review-requests).
# Set the same value in Vercel; Vercel Cron sends it as a Bearer token.
CRON_SECRET=a-long-random-string

# Jobber integration (OAuth). Used by the Jobber adapter once live API calls
# are wired. Create an app at developer.getjobber.com.
JOBBER_CLIENT_ID=your-jobber-client-id
JOBBER_CLIENT_SECRET=your-jobber-client-secret
JOBBER_REDIRECT_URI=https://app.steelscale.xyz/api/integrations/jobber/callback

# Housecall Pro integration (OAuth). Used by the Housecall Pro adapter once
# live API calls are wired.
HOUSECALL_CLIENT_ID=your-housecall-client-id
HOUSECALL_CLIENT_SECRET=your-housecall-client-secret
HOUSECALL_REDIRECT_URI=https://app.steelscale.xyz/api/integrations/housecall/callback
