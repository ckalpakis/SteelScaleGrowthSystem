# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key, used by API routes to insert leads and read client config.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployment (used for SEO canonical/JSON-LD links).
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Agency root domain. REQUIRED to enable client custom domains / subdomains.
# When set, any host that is not this domain (or www./app. of it, or a
# *.vercel.app preview) is treated as a client site:
#   - <slug>.steelscale.xyz        -> tenant by subdomain label
#   - a client's own domain        -> tenant by clients.domain lookup
# Leave unset to keep every request on the agency app (feature off).
ROOT_DOMAIN=steelscale.xyz

# Resend (email notifications for new leads)
RESEND_API_KEY=your-resend-api-key
# The verified "from" address Resend will send notifications from.
LEAD_NOTIFICATION_FROM="Steel City Growth <leads@yourdomain.com>"
# Steel Scale's own inbox, BCC'd on every client's new-lead email (optional).
AGENCY_NOTIFICATION_EMAIL="leads@steelscale.xyz"
